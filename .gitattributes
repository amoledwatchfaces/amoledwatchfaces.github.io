# Auto-detect text files and normalize line endings to LF in repository
* text=auto eol=lf

# Explicitly ensure HTML/CSS/JS/Markdown use LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Treat binaries as binary
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
